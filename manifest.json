{
  "manifest_version": 3,
  "name": "v2exthread",
  "version": "0.1.0",
  "description": "一个纯净的展示 v2ex 楼中楼的插件。",
  "content_scripts": [
    {
      "matches": ["https://www.v2ex.com/t/*", "https://v2ex.com/t/*"],
      "js": ["early.js"],
      "css": ["early.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.v2ex.com/t/*", "https://v2ex.com/t/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
